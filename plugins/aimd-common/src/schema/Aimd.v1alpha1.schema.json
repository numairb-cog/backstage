{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "AimdV1alpha1",
  "description": "An AIMD describes a markdown documentation entity that can be displayed in the catalog. The AIMD can be defined with markdown content loaded from files.",
  "examples": [
    {
      "apiVersion": "yourcompany.io/v1alpha1",
      "kind": "Aimd",
      "metadata": {
        "name": "user-guide",
        "description": "User guide documentation",
        "labels": {
          "product_name": "Documentation Portal"
        },
        "annotations": {
          "docs": "https://github.com/..../tree/develop/doc"
        }
      },
      "spec": {
        "type": "markdown",
        "lifecycle": "production",
        "owner": "documentation-team",
        "system": "docs-portal",
        "definition": "# User Guide\n\nThis is the user guide..."
      }
    }
  ],
  "allOf": [
    {
      "$ref": "Entity"
    },
    {
      "type": "object",
      "required": ["spec"],
      "properties": {
        "apiVersion": {
          "enum": ["yourcompany.io/v1alpha1"]
        },
        "kind": {
          "enum": ["Aimd"]
        },
        "spec": {
          "type": "object",
          "required": ["type", "lifecycle", "owner", "definition"],
          "properties": {
            "type": {
              "type": "string",
              "description": "The type of the AIMD definition.",
              "examples": ["markdown"],
              "minLength": 1
            },
            "lifecycle": {
              "type": "string",
              "description": "The lifecycle state of the AIMD.",
              "examples": ["experimental", "production", "deprecated"],
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "description": "An entity reference to the owner of the AIMD.",
              "examples": ["documentation-team", "user:john.johnson"],
              "minLength": 1
            },
            "system": {
              "type": "string",
              "description": "An entity reference to the system that the AIMD belongs to.",
              "minLength": 1
            },
            "definition": {
              "type": "string",
              "description": "The definition of the AIMD, containing the markdown content.",
              "minLength": 1
            }
          }
        }
      }
    }
  ]
}
